# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# Postgres (Neon on Vercel). Vercel's Neon integration sets this for you; the app
# also accepts POSTGRES_URL or a prefixed name such as STORAGE_DATABASE_URL
# (lib/database-url.mjs). sslmode=require is upgraded to verify-full.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 32 characters (e.g. `openssl rand -hex 32`). Required in production.
OTP_SECRET=

# Staff phone numbers allowed to log in to /admin, comma-separated.
ADMIN_PHONES=

# sms.ir. Leave SMSIR_API_KEY empty to use the mock provider (codes go to the server log).
SMSIR_API_KEY=
SMSIR_TEMPLATE_OTP=
SMSIR_TEMPLATE_CONFIRMED=
SMSIR_TEMPLATE_REMINDER=
SMSIR_TEMPLATE_CANCELLED=
SMSIR_TEMPLATE_MOVED=

# Protects the reminder cron endpoint (Vercel sends it automatically when set).
CRON_SECRET=
